# All settings are optional — sensible defaults apply. Prefix: NIDORA_

# Paths (defaults are relative to the working directory)
#NIDORA_MODELS_DIR=./models
#NIDORA_OUTPUTS_DIR=./outputs
#NIDORA_DB_PATH=./jobs.sqlite3

# Config files
#NIDORA_PIPELINES_CONFIG=./configs/pipelines.yaml
#NIDORA_MODELS_CONFIG=./configs/models.yaml

# Hardware
#NIDORA_DEVICE=cuda            # cuda | cpu (auto-detected when unset)
#NIDORA_DTYPE=bf16             # bf16 | fp16 | fp32
#NIDORA_OFFLOAD=none           # none | model | sequential | group
#NIDORA_ATTENTION=auto         # auto | sdpa | sage | flash

# Model provisioning
#NIDORA_AUTO_DOWNLOAD=0        # 1 = download missing models at startup (cloud pods)
#HF_TOKEN=                     # for gated HuggingFace repos

# Security — REQUIRED on any publicly reachable deployment.
# When set, /v1/* endpoints need "X-Api-Key: <key>" (or Authorization: Bearer).
#NIDORA_API_KEY=

# Server
#NIDORA_HOST=0.0.0.0
#NIDORA_PORT=8000
