# ============================================================================
# GPU POD  (docs/deploy-pods.md)
# ============================================================================
# MODEL_PATH, GATEWAY_URL and GATEWAY_AGENT_SECRET are REQUIRED; the rest is
# optional.

# Model (required, no default) + LoRA (optional, no default — omit for none)
MODEL_PATH=Wan-AI/Wan2.2-I2V-A14B-Diffusers
LORA_PATH=lightx2v/Wan2.2-Distill-Loras

# SGLang server
#PORT=8000
# Bind address. Defaults to 127.0.0.1 so nothing outside the container can reach
# the (unauthenticated) diffusion server; only change it to debug from the host.
#SGLANG_HOST=127.0.0.1

# Extra `sglang serve` flags appended verbatim, e.g.:
#   --attention-backend fa3 --enable-torch-compile true
#   --text-encoder-cpu-offload --dit-layerwise-offload
#SGLANG_EXTRA_ARGS=

# --- Gateway --------------------------------------------------------------
# The pull agent dials out, claims jobs and hands results back. It needs no
# port, no tunnel and no DNS record.
GATEWAY_URL=https://<your-hostname>
GATEWAY_AGENT_SECRET=             # must match the gateway's AGENT_SHARED_SECRET
#CF_ACCESS_CLIENT_ID=             # <service-token-id>.access
#CF_ACCESS_CLIENT_SECRET=

# What this pod serves is derived by the gateway from MODEL_PATH, so there is
# nothing to declare here — and no way to claim a capability the weights lack.
# SGLang serialises on the GPU, so >1 rarely helps.
#AGENT_MAX_IN_FLIGHT=1
# Stable identity across restarts, else a restarting pod orphans its own work.
# Auto-detected from RUNPOD_POD_ID / VAST_CONTAINER_ID / hostname.
#POD_ID=
#AGENT_JOB_TIMEOUT_S=900
#AGENT_LOG_LEVEL=INFO

# --- HuggingFace ------------------------------------------------------------
#HF_TOKEN=            # only for gated repos
# HF_HOME defaults to /workspace/hf in the image (persistent volume)


# ============================================================================
# GATEWAY  (deploy/README.md, docs/gateway.md)
# ============================================================================
# Used by gateway/compose.yml. Generate the secrets with
#   openssl rand -hex 32

# Comma-separated, so a key can be rotated without downtime: add the new one,
# migrate clients, then drop the old one. REQUIRED — the gateway refuses to boot
# without it.
#INFERENCE_API_KEYS=
# Shared by every pod as GATEWAY_AGENT_SECRET. REQUIRED.
#INFERENCE_AGENT_SECRET=
# Optional; /v1/pods falls back to the client keys when unset.
#INFERENCE_ADMIN_KEYS=
# Cloudflare Tunnel fronting <your-hostname>.
#INFERENCE_CF_TUNNEL_TOKEN=

# The image the stack runs. Swap the tag for a commit SHA to pin a release.
#INFERENCE_IMAGE=ghcr.io/nidora-software/nidora-ai-inference/gateway:latest
#INFERENCE_LOG_LEVEL=info
#INFERENCE_MEM_LIMIT=1g
# Admission-control ceiling. Beyond this the gateway returns 503 + Retry-After
# rather than queueing work that cannot clear inside a caller's timeout.
#INFERENCE_MAX_QUEUE_DEPTH=200
