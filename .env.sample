# All settings are optional except API_KEY on public deployments.

# Model + LoRA (defaults shown; LORA_PATH=none disables the LoRA)
#MODEL_PATH=Wan-AI/Wan2.2-I2V-A14B-Diffusers
#LORA_PATH=lightx2v/Wan2.2-Distill-Loras

# Security — REQUIRED on any publicly reachable deployment.
# Clients send: Authorization: Bearer <key>
#API_KEY=

# Server
#PORT=8000

# Stable HTTPS hostname via Cloudflare Tunnel (see docs/deploy-pods.md)
#CF_TUNNEL_TOKEN=

# Extra `sglang serve` flags appended verbatim, e.g.:
#   --attention-backend fa3 --enable-torch-compile true
#   --text-encoder-cpu-offload --dit-layerwise-offload
#SGLANG_EXTRA_ARGS=

# HuggingFace
#HF_TOKEN=            # only for gated repos
# HF_HOME defaults to /workspace/hf in the image (persistent volume)
