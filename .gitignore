# Environment
.env
.env.*
!.env.sample

# Local run artifacts (bind-mounted /workspace volume)
/workspace/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Gateway (Node)
node_modules/
gateway/dist/

# Agent (Python)
__pycache__/
*.egg-info/
# setuptools' staging copy of src/, written by `pip install -e agent[dev]`.
# Scoped rather than a bare `build/` so a future source directory of that name
# is not silently ignored.
agent/build/
.pytest_cache/
.venv/

# Legacy local artifacts
/outputs/
uv.lock
*.sqlite3
*.sqlite
*.sqlite-wal
*.sqlite-shm
